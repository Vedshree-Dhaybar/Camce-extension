{
    "manifest_version": 3,

    "name": "CAMCE Notes",

    "version": "1.0",

    "description": "Context-Aware Micro-Concept Extraction for Intelligent Lecture Note Generation",

    "permissions": [
        "activeTab",
        "tabs",
        "commands"
    ],

    "host_permissions": [
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "http://localhost:5000/*"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "commands": {
        "activate_camce": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y"
            },
            "description": "Pause video and open CAMCE"
        }
    },

    "content_scripts": [
        {
            "matches": [
                "https://*.youtube.com/*",
                "https://youtu.be/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}
